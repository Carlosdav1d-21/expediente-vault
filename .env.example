# Copia este archivo a .env y completa tus propias claves.
# NUNCA subas el archivo .env real a GitHub (ya está en .gitignore).

VITE_TMDB_API_KEY=tu_api_key_de_tmdb
VITE_RAWG_API_KEY=tu_api_key_de_rawg
# iTunes Search API es pública y no requiere key.

# Supabase (backend: auth + base de datos).
# Project URL y "anon / publishable key" del panel: Project Settings -> API Keys.
# La anon key es segura de exponer en el frontend; la seguridad la dan las
# políticas RLS de la base de datos. La service_role key NUNCA va aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_o_eyJ...
